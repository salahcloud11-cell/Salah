; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="مستيقظ أم لا؟"
run/main_scene="res://ui/MainMenu.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://settings/settings.gd"
MusicPlayer="*res://audio/music.gd"

[display]

window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[gui]

theme/custom_font="res://assets/fonts/ScheherazadeNew-Bold.ttf"

